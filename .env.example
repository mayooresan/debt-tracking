# Master password for dashboard access (required in production)
AUTH_PASSWORD=change_this_to_a_secure_master_password

# Secret key for signing session cookies (optional, auto-generated if omitted)
SESSION_SECRET=

# Preferred default base currency (e.g. USD, EUR, GBP)
BASE_CURRENCY=USD

# Server port
PORT=3000

# SQLite database file path (in container: /app/data/budget.db)
DB_PATH=./data/budget.db
